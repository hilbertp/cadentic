# Cadentic Mesocycle Engine — backend environment.
# Copy to `.env` (git-ignored) and fill in. `npm run dev` loads it automatically.

# --- Mode A: the owner's Claude subscription (Epic 2 story 2) ----------------
#
# On your own machine there is NOTHING to set here. The Agent SDK spawns Claude
# Code, which resolves the login you already signed in with — if you can run
# `claude`, this backend can generate. The flag below is the only requirement.
#
# Requires a Pro, Max, Team or Enterprise plan. Every request bills it.
#
# PERSONAL AND DEVELOPMENT USE ONLY. Running a subscription through the Agent
# SDK headless is supported on that basis; a deployment serving anyone other
# than the account's owner must run Mode B with per-user API keys. The backend
# refuses to start in Mode A without this flag, and logs the constraint at
# every startup.
MODE_A_PERSONAL_USE=true

# Only for CI, a container, or a server — anywhere without an interactive
# login. `claude setup-token` prints a one-year token (sk-ant-oat01-…) once.
# On a laptop that is already signed in, leave this unset: it would just
# authenticate the same account twice.
# CLAUDE_CODE_OAUTH_TOKEN=

# Do NOT set any of these. Each outranks the subscription in Claude Code's
# credential order, so the backend would start, requests would succeed, and the
# bill would land somewhere you did not intend. Mode A refuses to start if it
# finds one:
#   ANTHROPIC_API_KEY              -> the Claude API
#   ANTHROPIC_AUTH_TOKEN           -> wherever the bearer token points
#   ANTHROPIC_PROFILE              -> a Console/API organization
#   ANTHROPIC_FEDERATION_RULE_ID + ANTHROPIC_ORGANIZATION_ID -> an API org
#   CLAUDE_CODE_USE_BEDROCK / _VERTEX / _FOUNDRY             -> that cloud

# --- Endpoint ----------------------------------------------------------------

# Shared secret the app sends in X-Cadentic-Secret. At least 16 characters.
#   openssl rand -hex 32
CADENTIC_SHARED_SECRET=replace-me-with-32-random-bytes-hex

# 127.0.0.1 serves the emulator (which reaches the host at 10.0.2.2).
# For a physical device on the same Wi-Fi, set this to the machine's LAN address
# — e.g. 192.168.1.42. Never 0.0.0.0.
HOST=127.0.0.1
PORT=8787

# --- Optional ----------------------------------------------------------------

# A / B. B returns provider-not-available until story 6 ships.
AUTH_MODE=A

# MESOCYCLE_MODEL=claude-opus-5

# Whole-request budget, covering both generation attempts. The app's client
# timeout must sit above this so the backend's named `timeout` error wins.
# REQUEST_TIMEOUT_MS=300000

# How far ahead of requestDate a proposed startDate may sit.
# START_DATE_WINDOW_DAYS=14

# Log every raw model response to stderr. Useful when a plan comes out wrong;
# noisy otherwise.
# LOG_RAW_RESPONSES=false
