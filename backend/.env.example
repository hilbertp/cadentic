# Cadentic Mesocycle Engine — backend environment.
# Copy to `.env` (git-ignored) and fill in. `npm run dev` loads it automatically.

# --- Mode A: the owner's Claude subscription (Epic 2 story 2) ----------------
#
# One-time setup, on a machine with a browser:
#
#   1. claude setup-token
#      Opens the browser authorization flow and prints a one-year OAuth token
#      (sk-ant-oat01-…) once. It is not saved anywhere — copy it now.
#   2. Paste it below.
#
# Requires a Pro, Max, Team or Enterprise plan. Every request this backend makes
# bills that subscription.
#
# PERSONAL AND DEVELOPMENT USE ONLY. Running a subscription token in the Agent
# SDK headless is supported on that basis; a deployment serving anyone other
# than the token's owner must run Mode B with per-user API keys. The backend
# refuses to start in Mode A without the acknowledgement flag below.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-replace-me
MODE_A_PERSONAL_USE=true

# Do NOT set ANTHROPIC_API_KEY. It outranks CLAUDE_CODE_OAUTH_TOKEN in Claude
# Code's credential order, so requests would silently bill the API instead of
# the subscription. The backend refuses to start in Mode A if it is set.

# --- Endpoint ----------------------------------------------------------------

# Shared secret the app sends in X-Cadentic-Secret. At least 16 characters.
#   openssl rand -hex 32
CADENTIC_SHARED_SECRET=replace-me-with-32-random-bytes-hex

# 127.0.0.1 serves the emulator (which reaches the host at 10.0.2.2).
# For a physical device on the same Wi-Fi, set this to the machine's LAN address
# — e.g. 192.168.1.42. Never 0.0.0.0.
HOST=127.0.0.1
PORT=8787

# --- Optional ----------------------------------------------------------------

# A / B. B returns provider-not-available until story 6 ships.
AUTH_MODE=A

# MESOCYCLE_MODEL=claude-opus-5

# Whole-request budget, covering both generation attempts. The app's client
# timeout must sit above this so the backend's named `timeout` error wins.
# REQUEST_TIMEOUT_MS=300000

# How far ahead of requestDate a proposed startDate may sit.
# START_DATE_WINDOW_DAYS=14

# Log every raw model response to stderr. Useful when a plan comes out wrong;
# noisy otherwise.
# LOG_RAW_RESPONSES=false
